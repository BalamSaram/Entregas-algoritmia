Algoritmo RendimientoCombust
	//datos de entrada
	Definir Kilómetros, Litros, Rendimiento Como Real
	Escribir "Ingrese la cantidad de kilómetros: "
	Leer Kilómetros
	Escribir "Ingrese la cantidad de Litros: "
	Leer Litros	
	//procesamiento de los datos
	Rendimiento = Kilómetros/Litros
	Escribir "El rendimiento es: ", Rendimiento, "km/L"
FinAlgoritmo