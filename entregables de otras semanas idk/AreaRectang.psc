Algoritmo AreaRectáng
	//datos de entrada
	Definir base, altura, area Como Real
	Escribir "Ingrese la base del rectángulo en cm:"
	Leer base
	Escribir "Ingrese la altura del rectángulo en cm:"
	Leer altura
	
	//procesamiento de los datos
	area=base*altura
	Escribir "El área del rectángulo es: ", area, "cm^2"
FinAlgoritmo