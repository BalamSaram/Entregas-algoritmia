Algoritmo CelsiusFahrenheit
	//datos de entrada
	Definir celsius, temperatura Como Real
	Escribir "Ingrese la temperatura en celsius: "
	Leer celsius
	
	//procesamiento de los datos
	temperatura=(celsius*(9/5))+32
	Escribir "La temperatura ingresada en Fahrenheit es:", temperatura, "°F"
FinAlgoritmo